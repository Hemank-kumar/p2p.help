# ============================
#   MERN STACK .gitignore
# ============================

# Node modules (backend & frontend)
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# Build outputs
build/
dist/
frontend/build/
frontend/dist/
backend/build/
backend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Cache
.cache/
frontend/.cache/
server/.cache/
*.tmp
*.swp

# Vite / Webpack
.vite/
frontend/.vite/
*.tsbuildinfo

# Coverage
coverage/
frontend/coverage/
backend/coverage/
*.lcov

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Local data (Mongo dumps)
dump/
*.bson
*.json.gz

# Uploads folder (if storing local files)
uploads/
public/uploads/

# Optional lock files (uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
